/* pages/chat/chat.wxss */
.chat-container {
  width: 100%;
  height: 100vh;
  background-color: #f0f2f5;
  position: relative;
  overflow: hidden;
}

/* 消息列表：绝对定位，动态 bottom */
.msg-list {
  position: absolute;
  left: 0;
  right: 0;
  padding: 20rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

/* 输入栏：固定定位，动态 bottom */
.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.03);
  z-index: 10;
  /* bottom 由 JS 动态设置，这里先给个默认值 */
  bottom: 0;
}

.msg-item {
  margin-bottom: 30rpx;
  display: flex;
  flex-direction: column;
}

.msg-item.user {
  align-items: flex-end;
}

.msg-item.assistant {
  align-items: flex-start;
}

.msg-img {
  max-width: 400rpx;
  max-height: 400rpx;
  border-radius: 16rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.msg-bubble {
  margin-top: 10rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  max-width: 80%;
  word-break: break-all;
  font-size: 28rpx;
  line-height: 1.6;
}

.user .msg-bubble {
  background-color: #07c160;
  color: #fff;
  border-top-right-radius: 6rpx;
}

.assistant .msg-bubble {
  background-color: #fff;
  color: #333;
  border-top-left-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.loading-bubble {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.loading-dot {
  font-size: 24rpx;
  color: #999;
  animation: blink 1.4s infinite;
}
.loading-dot.delay1 { animation-delay: 0.2s; }
.loading-dot.delay2 { animation-delay: 0.4s; }

@keyframes blink {
  0%, 80%, 100% { opacity: 0.2; }
  40% { opacity: 1; }
}

/* ==================== 空状态占位 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;          /* 撑满 msg-list 的高度实现居中 */
  text-align: center;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.empty-image {
  width: 100%;
  height: auto;
  margin-bottom: 30rpx;
  /* 若图片暂时没有，背景可起占位作用 */
  background-color: transparent;
}

.empty-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
  white-space: pre-line;  /* 让 \n 换行生效 */
}

/* ==================== 输入区 ==================== */
.input-bar {
  background-color: #fff;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.03);
  flex-shrink: 0; /* 防止被键盘压缩 */
}

/* 图片缩略图 */
.preview-thumb {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 10rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #f5f5f5;
  display: inline-block;
}
.preview-thumb image {
  width: 100%;
  height: 100%;
}
.remove-img {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: rgba(0,0,0,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  line-height: 1;
}

/* ===== 核心：输入行 ===== */
.input-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ===== 3D 绿色图片按钮 ===== */
.img-btn {
  width: 80rpx !important;
  height: 80rpx !important;
  min-width: 80rpx !important;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
  border-radius: 50% !important;
  /* 绿色 3D 渐变背景 */
  background: linear-gradient(145deg, #2ecc71, #27ae60) !important;
  /* 立体阴影 */
  box-shadow: 
    0 6rpx 12rpx rgba(39, 174, 96, 0.4),
    0 2rpx 4rpx rgba(0,0,0,0.15),
    inset 0 -2rpx 4rpx rgba(0,0,0,0.2),
    inset 0 2rpx 4rpx rgba(255,255,255,0.3);
  display: flex !important;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  line-height: normal !important;
  transition: all 0.1s ease;
  position: relative;
}

/* 按下时：下沉效果 */
.img-btn:active {
  box-shadow: 
    0 2rpx 6rpx rgba(39, 174, 96, 0.3),
    inset 0 2rpx 6rpx rgba(0,0,0,0.3),
    inset 0 -1rpx 2rpx rgba(255,255,255,0.2);
  transform: translateY(2rpx);
}

/* 白色图标 */
.camera-icon {
  width: 50rpx;
  height: 50rpx;
  display: block;
  /* 将图标变为纯白色 */
  filter: brightness(0) invert(1);
  -webkit-filter: brightness(0) invert(1);
}

/* 输入框 */
.text-input {
  flex: 1;
  height: 72rpx;
  min-height: 72rpx;
  background-color: #f7f7f7;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  margin: 0 16rpx;
  border: 2rpx solid #e0e0e0;
  box-sizing: border-box;
}

/* 发送按钮 */
.send-btn {
  width: 120rpx !important;
  height: 72rpx !important;
  min-width: 120rpx !important;
  margin: 0 !important;
  padding: 0 !important;
  background-color: #07c160 !important;
  color: #fff !important;
  font-size: 28rpx !important;
  font-weight: 500;
  border-radius: 36rpx !important;
  border: none !important;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.send-btn[disabled] {
  background-color: #c0c0c0 !important;
  color: #fff !important;
}
.send-btn::after {
  border: none !important;
}