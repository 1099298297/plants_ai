<!-- login.wxml -->
<view class="container">
  <view class="header">
    <view class="title">欢迎使用</view>
    <view class="subtitle">藤丰园林智能助手</view>
  </view>

  <view class="auth-section">
    <!-- 头像按钮：可选 -->
    <button class="avatar-wrapper" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar" src="{{avatarUrl || defaultAvatar}}" mode="aspectFill"></image>
    </button>
    <view class="tip">点击头像可修改（可选）</view>

    <!-- 昵称输入框：自动聚焦 -->
    <view class="nickname-box">
      <text class="label">昵称</text>
      <input 
        type="nickname" 
        class="nickname-input" 
        placeholder="点击授权微信昵称" 
        value="{{nickName}}" 
        bindinput="onNicknameInput"
        bindblur="onNicknameBlur"
        focus="{{focusNickname}}"
      />
    </view>
  </view>

  <button class="login-btn" type="primary" bindtap="handleLogin">授权并登录</button>
  <view class="cancel-text" bindtap="goBack">暂不登录</view>
</view>