page {
  background: #f2f5f2;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 20rpx 36rpx;
  color: #233029;
}

.checking,
.denied {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  text-align: center;
  color: #7b857e;
  font-size: 27rpx;
}

.loading-ring {
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 24rpx;
  border: 5rpx solid #dce9df;
  border-top-color: #2f8f5b;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.denied-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff1e8;
  color: #d96a2b;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 96rpx;
}

.denied-title {
  margin-top: 28rpx;
  color: #26342c;
  font-size: 36rpx;
  font-weight: 700;
}

.denied-tip {
  margin-top: 18rpx;
  line-height: 1.65;
}

.openid-box {
  width: 100%;
  margin-top: 32rpx;
  padding: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid #dbe3dc;
  border-radius: 18rpx;
  background: #fff;
}

.openid {
  display: block;
  color: #35443b;
  font-size: 24rpx;
  word-break: break-all;
}

.copy-tip {
  display: block;
  margin-top: 14rpx;
  color: #2f8f5b;
  font-size: 23rpx;
}

.retry-btn {
  width: 280rpx;
  margin-top: 36rpx;
  border: 0;
  border-radius: 44rpx;
  background: #2f8f5b;
  color: #fff;
  font-size: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(47, 143, 91, 0.2);
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(125deg, #123f2a 0%, #286f49 58%, #5e9969 100%);
  box-shadow: 0 10rpx 26rpx rgba(30, 83, 53, 0.14);
  color: #fff;
}

.hero::after {
  content: '';
  position: absolute;
  top: -70rpx;
  right: 100rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.hero-top,
.hero-meta,
.order-head,
.order-foot,
.list-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.eyebrow {
  display: block;
  opacity: 0.72;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.hero-title {
  display: block;
  margin-top: 6rpx;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.active-badge {
  position: relative;
  z-index: 1;
  min-width: 226rpx;
  padding: 10rpx 16rpx 12rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.12);
  text-align: center;
}

.todo-heading {
  display: block;
  font-size: 20rpx;
  line-height: 1.2;
  opacity: 0.72;
}

.todo-counts {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 7rpx;
}

.todo-count {
  min-width: 78rpx;
}

.todo-number {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
}

.todo-label {
  display: block;
  margin-top: 5rpx;
  font-size: 20rpx;
  opacity: 0.8;
}

.todo-divider {
  width: 1rpx;
  height: 40rpx;
  margin: 0 14rpx;
  background: rgba(255, 255, 255, 0.28);
}

.order-search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
}

.order-search-input {
  flex: 1;
  min-width: 0;
  height: 66rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #dfe6e0;
  border-radius: 14rpx;
  background: #fff;
}

.search-prefix {
  flex: 0 0 auto;
  margin-right: 14rpx;
  color: #2f8f5b;
  font-size: 22rpx;
  font-weight: 700;
}

.order-search-input input {
  flex: 1;
  min-width: 0;
  color: #344139;
  font-size: 24rpx;
}

.search-clear {
  flex: 0 0 auto;
  width: 44rpx;
  color: #9aa39d;
  font-size: 32rpx;
  line-height: 44rpx;
  text-align: center;
}

.search-submit {
  flex: 0 0 108rpx;
  width: 108rpx;
  height: 66rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 14rpx;
  background: #2f8f5b;
  color: #fff;
  font-size: 24rpx;
  line-height: 66rpx;
}

.search-submit::after {
  border: 0;
}

.search-result-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  background: #eef5f0;
  color: #77827a;
  font-size: 22rpx;
}

.search-result-clear {
  color: #2f8f5b;
}

.notice-card {
  margin-top: 22rpx;
  padding: 24rpx;
  border: 1rpx solid #e3e9e4;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8fbf9 100%);
}

.notice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.notice-copy {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.notice-title,
.notice-desc,
.notice-status {
  display: block;
}

.notice-title {
  color: #29372e;
  font-size: 29rpx;
  font-weight: 700;
}

.notice-desc {
  margin-top: 10rpx;
  color: #7e8981;
  font-size: 23rpx;
  line-height: 1.55;
}

.notice-btn {
  flex: 0 0 132rpx;
  width: 132rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 32rpx;
  background: #e9f5ed;
  color: #25794b;
  font-size: 22rpx;
  line-height: 58rpx;
  text-align: center;
}

.notice-btn.accepted {
  background: #eff1ef;
  color: #68736b;
}

.notice-btn::after {
  border: 0;
}

.notice-status {
  margin-top: 16rpx;
  color: #9aa39d;
  font-size: 21rpx;
  text-align: right;
}

.status-tabs {
  width: 100%;
  margin: 20rpx 0 14rpx;
  white-space: nowrap;
}

.status-tab {
  display: inline-block;
  min-width: 96rpx;
  margin-right: 10rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border: 1rpx solid #dfe6e0;
  border-radius: 30rpx;
  background: #f9fbf9;
  color: #67736a;
  font-size: 23rpx;
  line-height: 58rpx;
  text-align: center;
}

.status-tab.active {
  border-color: #2f8f5b;
  background: #2f8f5b;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 5rpx 14rpx rgba(47, 143, 91, 0.18);
}

.list-heading {
  padding: 2rpx 4rpx 12rpx;
}

.list-title {
  color: #536058;
  font-size: 24rpx;
  font-weight: 600;
}

.list-hint {
  color: #9aa39d;
  font-size: 22rpx;
}

.order-card {
  position: relative;
  margin-bottom: 12rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #e6ebe7;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 5rpx 18rpx rgba(31, 51, 39, 0.035);
}

.order-card:active {
  background: #fbfcfb;
}

.order-no,
.order-time {
  display: block;
}

.order-no {
  color: #26352c;
  font-size: 25rpx;
  font-weight: 700;
}

.order-time {
  margin-top: 5rpx;
  color: #9aa39d;
  font-size: 21rpx;
}

.order-status {
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  font-size: 21rpx;
  font-weight: 600;
}

.order-status.pending {
  background: #fff3df;
  color: #b76b00;
}

.order-status.paid {
  background: #e7f2ff;
  color: #2474ba;
}

.order-status.shipped {
  background: #eaf5ec;
  color: #28784a;
}

.order-status.completed {
  background: #edf0ee;
  color: #59645c;
}

.order-status.cancelled {
  background: #f1f1f1;
  color: #999;
}

.order-card.status-pending {
  border-left: 6rpx solid #e6a23c;
}

.order-card.status-paid {
  border-left: 6rpx solid #4e88c7;
}

.order-card.status-shipped {
  border-left: 6rpx solid #2f8f5b;
}

.order-card.status-completed {
  border-left: 6rpx solid #8c9890;
}

.order-card.status-cancelled {
  border-left: 6rpx solid #c7cbc8;
}

.compact-order-body {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #eef1ef;
}

.compact-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.compact-row + .compact-row {
  margin-top: 7rpx;
}

.compact-label {
  flex: 0 0 62rpx;
  margin-right: 10rpx;
  color: #9aa39d;
  font-size: 20rpx;
}

.product-summary,
.receiver-summary {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-summary {
  flex: 1;
  min-width: 0;
  color: #38453d;
  font-size: 23rpx;
  line-height: 1.45;
}

.receiver-summary {
  flex: 1;
  min-width: 0;
  color: #8b958e;
  font-size: 21rpx;
}

.goods-list {
  margin-top: 22rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #eef1ef;
  border-bottom: 1rpx solid #eef1ef;
}

.goods {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.goods-image {
  flex: 0 0 92rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 14rpx;
  background: #f1f3f1;
}

.goods-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.goods-name,
.goods-spec,
.goods-price {
  display: block;
}

.goods-name {
  overflow: hidden;
  color: #303c34;
  font-size: 25rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-spec {
  margin-top: 4rpx;
  color: #939d96;
  font-size: 21rpx;
}

.goods-price {
  margin-top: 6rpx;
  color: #68736b;
  font-size: 22rpx;
}

.more-goods {
  display: block;
  margin: 10rpx 0 0 110rpx;
  color: #9aa39d;
  font-size: 21rpx;
}

.receiver {
  padding: 20rpx 0 4rpx;
}

.receiver-name,
.receiver-address {
  display: block;
}

.receiver-name {
  color: #4d5b52;
  font-size: 24rpx;
  font-weight: 600;
}

.receiver-address {
  margin-top: 8rpx;
  color: #7d8880;
  font-size: 22rpx;
  line-height: 1.5;
}

.order-foot {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #f0f2f0;
}

.item-count {
  color: #89938c;
  font-size: 20rpx;
}

.amount {
  display: block;
  margin-top: 2rpx;
  color: #d55b35;
  font-size: 28rpx;
  font-weight: 700;
}

.action-btn {
  width: 136rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 30rpx;
  font-size: 22rpx;
  line-height: 50rpx;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

.action-btn.primary {
  background: #2f8f5b;
  color: #fff;
}

.action-btn.mark-paid {
  width: 136rpx;
  box-sizing: border-box;
  border: 1rpx solid #c9e5d1;
  background: #e9f6ed;
  color: #26784a;
  font-weight: 600;
}

.action-btn.complete {
  border: 1rpx solid #d9e7dd;
  background: #eef5f0;
  color: #28784a;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #e7f2ea;
  color: #2f8f5b;
  font-size: 42rpx;
  line-height: 88rpx;
  text-align: center;
}

.empty-title {
  margin-top: 24rpx;
  color: #536058;
  font-size: 29rpx;
  font-weight: 600;
}

.empty-tip {
  margin-top: 10rpx;
  color: #9aa39d;
  font-size: 23rpx;
}

.pagination {
  margin: 18rpx 0 8rpx;
  padding: 16rpx;
  border: 1rpx solid #e4e9e5;
  border-radius: 16rpx;
  background: #fff;
}

.pagination-buttons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.page-arrow,
.page-number {
  height: 50rpx;
  box-sizing: border-box;
  border: 1rpx solid #dde5df;
  border-radius: 10rpx;
  background: #fff;
  color: #5e6a62;
  font-size: 21rpx;
  line-height: 48rpx;
  text-align: center;
}

.page-arrow {
  width: 108rpx;
  margin: 0;
  padding: 0;
}

.page-arrow[disabled] {
  background: #f5f6f5;
  color: #b7beb9;
}

.page-number {
  min-width: 48rpx;
  padding: 0 8rpx;
}

.page-number.active {
  border-color: #2f8f5b;
  background: #2f8f5b;
  color: #fff;
  font-weight: 600;
}

.page-summary {
  display: block;
  margin-top: 10rpx;
  color: #8d978f;
  font-size: 21rpx;
  text-align: center;
}

.detail-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 28, 21, 0.48);
}

.detail-sheet {
  position: relative;
  width: 100%;
  max-height: 84vh;
  padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 28rpx 28rpx 0 0;
  background: linear-gradient(180deg, #fbfcfb 0%, #f3f6f3 100%);
}

.detail-sheet::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 50%;
  width: 62rpx;
  height: 7rpx;
  border-radius: 4rpx;
  background: #d9dfda;
  transform: translateX(-50%);
}

.detail-header,
.detail-summary,
.detail-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-title {
  display: block;
  color: #243229;
  font-size: 32rpx;
  font-weight: 700;
}

.detail-order-no {
  display: block;
  margin-top: 5rpx;
  color: #929c95;
  font-size: 21rpx;
}

.detail-close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #edf1ee;
  color: #637068;
  font-size: 38rpx;
  line-height: 54rpx;
  text-align: center;
}

.detail-scroll {
  height: 65vh;
  margin-top: 14rpx;
}

.detail-summary,
.detail-section {
  margin-bottom: 16rpx;
  padding: 22rpx;
  border: 1rpx solid #e4e9e5;
  border-radius: 16rpx;
  background: #fff;
}

.detail-summary-right {
  text-align: right;
}

.detail-label,
.detail-value {
  display: block;
  font-size: 23rpx;
}

.detail-label {
  color: #929c95;
}

.detail-value {
  margin-top: 5rpx;
  color: #344139;
  font-weight: 600;
}

.detail-amount {
  display: block;
  margin-top: 4rpx;
  color: #d55b35;
  font-size: 32rpx;
  font-weight: 700;
}

.detail-section-title {
  display: block;
  margin-bottom: 14rpx;
  padding-left: 12rpx;
  border-left: 5rpx solid #2f8f5b;
  color: #35433a;
  font-size: 25rpx;
  font-weight: 700;
}

.detail-goods {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.detail-goods + .detail-goods {
  border-top: 1rpx solid #f0f2f0;
}

.detail-goods-image {
  flex: 0 0 112rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 14rpx;
  background: #eef1ee;
}

.detail-goods-copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.detail-goods-name,
.detail-goods-spec,
.detail-goods-price {
  display: block;
}

.detail-goods-name {
  color: #303d35;
  font-size: 25rpx;
  font-weight: 600;
}

.detail-goods-spec {
  margin-top: 5rpx;
  color: #8e9891;
  font-size: 21rpx;
}

.detail-goods-price {
  margin-top: 7rpx;
  color: #5e6b62;
  font-size: 22rpx;
}

.detail-line {
  display: block;
  color: #3f4d44;
  font-size: 24rpx;
  line-height: 1.55;
}

.detail-line.secondary {
  margin-top: 6rpx;
  color: #828d85;
  font-size: 22rpx;
}

.detail-info-row + .detail-info-row {
  margin-top: 14rpx;
}

.detail-info-row .detail-value {
  margin-top: 0;
  text-align: right;
}
