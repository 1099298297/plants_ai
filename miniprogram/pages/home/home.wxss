/* ================= 全局样式 ================= */
.home-page {
  width: 100vw;
  min-height: 100vh;
  box-sizing: border-box;
  overflow-x: hidden;
  background-color: #ffffff; 
}

/* ================= 1. 顶部浅绿背景区 ================= */
.top-banner {
  width: 100%;
  height: 480rpx;
  background: linear-gradient(180deg, #f0f9f0 0%, #ffffff 100%);
  position: relative;
  padding: 0 40rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* 顶部模糊植物背景（用image标签实现） */
.top-bg {
  position: absolute;
  top: 0;
  right: 0;
  width: 100%;
  height: 100%;
  opacity: 0.7;
  z-index: 0;
}

.banner-header {
  position: relative;
  z-index: 1;
  padding-top: 80rpx;
  display: flex;
  flex-direction: column;
}

.logo-box {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.logo-cn {
  font-size: 52rpx;
  font-weight: bold;
  color: #2d3436;
  margin-right: 16rpx;
}

.logo-en {
  font-size: 36rpx;
  color: #66bb6a;
  font-style: italic;
}

.slogan {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 40rpx;
}

.icon-item image {
  width: 40rpx;
  height: 40rpx;
}

/* 搜索栏 */
.search-bar {
  position: relative;
  z-index: 1;
  width: 65%;
  height: 58rpx;
  background: #ffffff;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333333;
  margin: 0 20rpx;
}

/* ================= 2. 主体内容区 ================= */
.main-content {
  width: 100%;
  padding: 0 40rpx;
  box-sizing: border-box;
  padding-bottom: 100rpx;
  margin-top: -80rpx; 
  position: relative; 
  z-index: 10; 
}

/* 两个功能卡片横向排列 */
.action-row {
  display: flex;
  justify-content: space-between; 
  width: 100%;
  margin-bottom: 60rpx;
}

/* 单个功能卡片 */
.action-card-left{
  width: 40%; 
  background: #f6f8f5;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-right: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04); 
  border: 1rpx solid #f5f5f5;
}
.action-card {
  width: 40%; 
  background: #f6f8f5;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04); 
  border: 1rpx solid #f5f5f5;
}

.card-left {
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.card-subtitle {
  font-size: 22rpx;
  color: #807f7f;
  margin-bottom: 24rpx;
}

.go-link {
  padding: 10rpx 0rpx 10rpx 3rpx; 
  background-color: #e3f7e3;
  font-size: 22rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  display: flex;
  align-items: center; 
  justify-content: center; 
  color: #3f8f43;
  line-height: 1; 
}

.go-link .arrow {
  margin-left: 6rpx;
}

/* 右侧绿色圆形图标（中心径向渐变版） */
.card-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  margin-top: 25rpx;
  justify-content: center;
  align-items: center;
  background: radial-gradient(circle at 35% 35%, #a5d6a7 0%, #81c784 40%, #66bb6a 100%);
box-shadow: 0 8rpx 20rpx rgba(102, 187, 106, 0.35), 0 2rpx 6rpx rgba(129, 199, 132, 0.2);
}

.card-icon image {
  width: 56rpx;
  height: 56rpx;
  filter: brightness(0) invert(1); /* 将图标变成白色 */
}

/* ================= 3. 最近识别区 ================= */
.history-section {
  width: 100%;
  margin-bottom: 60rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.all-link {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666666;
}

.all-link .arrow {
  margin-left: 6rpx;
}

/* 空状态 */
.empty-state {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 24rpx;
}

.empty-img {
  height: 270rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 20rpx;
  text-align: center;
}

/* 登录按钮 */
.login-button {
  background-color: #66bb6a !important;
  color: #ffffff !important;
  width: 60% !important;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 18rpx 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.login-button::after {
  border: none;
}

/* 横向滚动历史列表 */
.history-scroll {
  width: 100%;
  white-space: nowrap;
}

.history-item {
  display: inline-block;
  width: 220rpx;
  margin-right: 24rpx;
  vertical-align: top;
}

.plant-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  background-color: #f5f7f5;
}

.plant-name-cn {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plant-name-en {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-style: italic;
}

.time-text {
  display: block;
  font-size: 20rpx;
  color: #bbbbbb;
}

/* ================= 4. 促销横幅 ================= */
.promo-banner {
  width: 100%;
  height: 280rpx;
  background: linear-gradient(135deg, #f0f9f0 0%, #e8f5e8 100%);
  border-radius: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40rpx;
  box-sizing: border-box;
  overflow: hidden;
  position: relative;
}

.banner-left {
  display: flex;
  flex-direction: column;
  z-index: 1;
}

.promo-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #2e7d32;
  margin-bottom: 12rpx;
}

.promo-subtitle {
  font-size: 28rpx;
  color: #43a047;
  margin-bottom: 32rpx;
}

.go-shop-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #66bb6a 0%, #43a047 100%);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(102, 187, 106, 0.3);
}

.go-shop-btn .arrow {
  margin-left: 6rpx;
}

/* 右侧植物图片（用image标签实现） */
.banner-right {
  position: absolute;
  width: 100%;
  right: 0;
  bottom: 0;
  z-index: 0;
}