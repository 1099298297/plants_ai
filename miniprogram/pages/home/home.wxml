<view class="home-page">
  <!-- 1. 顶部浅绿背景区 -->
  <view class="top-banner">
    <!-- 顶部模糊植物背景（用image标签替代wxss背景图） -->
    <image class="top-bg" src="/images/home/bg.png" mode="aspectFill"></image>
    
    <view class="banner-header">
      <view class="logo-box">
        <text class="logo-cn">藤丰园林</text>
        <text class="logo-en">GardenLab</text>
      </view>
      <text class="slogan">让生活与自然更近一点</text>
    </view>
    
    <!-- 搜索栏 -->
    <view class="search-bar" bindtap="focusSearch">
      <input class="search-input"
            placeholder="搜索绿植、商品..."
            placeholder-style="color:#999;"
            value="{{searchKeyword}}"
            bindinput="onSearchInput"
            bindconfirm="onSearchConfirm"
            confirm-type="search"/>
      <image class="search-icon" src="/images/icons/search.png" mode="aspectFit" bindtap="onSearchConfirm"></image>
    </view>
  </view>

  <!-- 2. 主体内容区 -->
  <view class="main-content">
    
    <!-- 两个核心功能卡片 -->
    <view class="action-row">
      <view class="action-card-left" bindtap="navigateToPlantRecognition">
        <view class="card-left">
          <text class="card-title">植物识别</text>
          <text class="card-subtitle">拍照识别植物</text>
          <view class="go-link">
            <text>去识别</text>
            <text class="arrow">></text>
          </view>
        </view>
        <view class="card-icon">
          <image src="/images/icons/camera.png" mode="aspectFit"></image>
        </view>
      </view>
      
      <view class="action-card" bindtap="navigateToVoiceChat">
        <view class="card-left">
          <text class="card-title">智能对话</text>
          <text class="card-subtitle">植物养护咨询</text>
          <view class="go-link">
            <text>去对话</text>
            <text class="arrow">></text>
          </view>
        </view>
        <view class="card-icon">
          <image src="/images/icons/chat.png" mode="aspectFit"></image>
        </view>
      </view>
    </view>

    <!-- 3. 最近识别区（横向滚动） -->
    <view class="history-section">
      <view class="section-header">
        <text class="section-title">最近识别</text>
        <view class="all-link" bindtap="goToAllHistory">
          <text>全部记录</text>
          <text class="arrow">></text>
        </view>
      </view>
      
      <!-- 状态一：未登录 -->
      <view class="empty-state" wx:if="{{!isLoggedIn}}">
        <text class="empty-text">需要登录才能存储和查看最近记录哦</text>
        <button class="login-button" type="primary" bindtap="goToLogin">去登录</button>
      </view>

      <!-- 状态二：已登录 -->
      <block wx:else>
        <!-- 无记录 -->
        <view class="empty-state" wx:if="{{historyList.length === 0}}">
          <image class="empty-img" src="/images/home/hover.png" mode="aspectFit"></image>
          <text class="empty-text">暂无识别记录，快去探索吧~</text>
        </view>

        <!-- 有记录：横向滚动列表 -->
        <scroll-view class="history-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}" wx:else>
          <view class="history-item" wx:for="{{historyList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
            <image class="plant-img" src="{{item.image}}" mode="aspectFill"></image>
            <text class="plant-name-cn">{{item.basicInfo.name}}</text>
            <text class="plant-name-en">{{item.basicInfo.latinName || item.basicInfo.family}}</text>
            <text class="time-text">{{item.time}}</text>
          </view>
        </scroll-view>
      </block>
    </view>

    <!-- 4. 促销横幅 -->
    <view class="promo-banner" bindtap="goToShop">
      <view class="banner-left">
        <text class="promo-title">春日焕新季</text>
        <text class="promo-subtitle">精选绿植 低至7折</text>
        <view class="go-shop-btn">
          <text>去选购</text>
          <text class="arrow">></text>
        </view>
      </view>
      <image class="banner-right" src="/images/home/ad_bg.png" mode="aspectFill"></image>
    </view>
  </view>
</view>