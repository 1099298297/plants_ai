.container {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 顶部按钮 */

.top-bar {
  margin-bottom: 24rpx;
}

.location-btn {
  height: 88rpx;
  background: #4CAF50;
  border-radius: 44rpx;
  color: #fff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 列表 */

.address-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.address-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
}

.address-content {
  flex: 1;
}

.address-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.item-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.item-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 编辑按钮 */
.edit-btn {
  width: 88rpx;
  height: 46rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  color: #fff;

  font-size: 22rpx;
  font-weight: 500;

  border-radius: 24rpx;

  box-shadow: 0 4rpx 10rpx rgba(76, 175, 80, 0.18);
}

/* 删除按钮 */
.delete-btn {
  width: 88rpx;
  height: 46rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #f1f3f5;
  color: #666;

  font-size: 22rpx;
  font-weight: 500;

  border-radius: 24rpx;
}

/* 点击效果 */
.edit-btn:active,
.delete-btn:active {
  transform: scale(0.95);
}
/* 空状态 */

.empty-box {
  padding-top: 200rpx;
  display: flex;
  justify-content: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}