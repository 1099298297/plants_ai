/* addPlant.wxss */
.container {
  padding: 30rpx;
  padding-bottom: 180rpx;
  background: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.edit-tip {
  text-align: center;
  background-color: #E8F5E9;
  color: #4CAF50;
  padding: 16rpx;
  border-radius: 30rpx;
  margin-bottom: 30rpx;
  font-size: 26rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.image-upload {
  width: 220rpx;
  height: 220rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}

.upload-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.input,
.picker,
.address-box {
  background: #fff;
  min-height: 88rpx;
  border-radius: 24rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  font-size: 28rpx;
}

.address-box {
  justify-content: space-between;
}

.address-text {
  flex: 1;
  color: #333;
}

.address-placeholder {
  color: #999;
}

.arrow {
  color: #999;
  font-size: 32rpx;
}

.footer-btns {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  gap: 20rpx;
  box-sizing: border-box;
}

.cancel-btn,
.confirm-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.cancel-btn {
  background: #f1f1f1;
  color: #666;
}

.confirm-btn {
  background: #4CAF50;
  color: #fff;
}

.confirm-btn::after {
  display: none;
}