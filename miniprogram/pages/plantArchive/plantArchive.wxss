/* plantArchive.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.add-btn {
  display: flex;
  align-items: center;
  background-color: #07c160;
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}

.add-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.content {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
}

.plant-list {
  min-height: 200rpx;
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 40rpx 0;
}

.plant-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
  transition: all 0.2s;
}

.plant-item:active {
  background-color: #f8f8f8;
}

.plant-content {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.plant-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.plant-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.plant-nickname {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.plant-species {
  font-size: 28rpx;
  color: #666;
}

.plant-date {
  font-size: 24rpx;
  color: #999;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  align-items: center;
  flex-shrink: 0;
}

.edit-btn, .delete-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 8rpx;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.edit-btn:active, .delete-btn:active {
  background-color: #f0f0f0;
  transform: scale(0.95);
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
}

.edit-btn text, .delete-btn text {
  font-size: 22rpx;
  color: #666;
}

.delete-btn text {
  color: #f44336;
}