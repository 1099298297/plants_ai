.container {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 30rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
}

.textarea {
  width: 100%;
  height: 240rpx;
  font-size: 30rpx;
  color: #333;
}

.save-btn {
  margin-top: 40rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #4CAF50;
  color: #fff;
  font-size: 30rpx;
}

.save-btn::after {
  display: none;
}