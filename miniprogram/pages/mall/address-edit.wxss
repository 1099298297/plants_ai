.container {
  padding: 20rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.form {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 0 30rpx;
}

.form-item {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #eee;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  color: #333;
}

.picker {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #333;
}

.placeholder {
  color: #999;
}

.textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  color: #333;
}

.switch {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.switch .label {
  margin-bottom: 0;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
} 

/* 在原有样式后追加以下内容 */
.address-actions {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.address-actions .textarea {
  flex: 1;
  height: 160rpx;        /* 保持原高度 */
}

.map-btn {
  height: 80rpx;
  padding: 0 24rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #333;
  white-space: nowrap;
  flex-shrink: 0;
  margin-top: 4rpx;      /* 与 textarea 顶部对齐微调 */
}

.map-btn:active {
  background: #e5e5e5;
}

.map-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}