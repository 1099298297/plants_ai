<!--checkout.wxml-->
<view class="container">

  <view class="card address-card" bindtap="goSelectAddress">
  <image class="address-bg-img" src="/images/mall/local.png" mode="widthFix"></image>
  
  <view class="address-text-area" wx:if="{{hasAddress}}">
    <view class="address-row">
      <text class="name">{{address.name}}</text>
      <text class="phone">{{address.phone}}</text>
      <view class="default-tag" wx:if="{{address.isDefault}}">默认</view>
    </view>
    <view class="address-detail-text">
      {{address.province}}{{address.city}}{{address.district}}{{address.detail}}
    </view>
  </view>

  <view class="address-text-area" wx:else>
    <view class="address-row">
      <text class="name placeholder-text">请添加收货地址</text>
    </view>
    <view class="address-detail-text placeholder-sub">点击选择地址</view>
  </view>
</view>

<!-- 商品卡片：永远循环 cartList -->
<view class="card goods-card">
  <view class="section-title">商品信息</view>

  <view class="goods-item" wx:for="{{cartList}}" wx:key="id">
    <image src="{{item.image[0]}}" mode="aspectFill"></image>
    <view class="goods-info">
      <text class="name">{{item.name}}</text>
      <text class="spec" wx:if="{{item.spec}}">{{item.spec}}</text>
      <text class="price">¥{{item.price}}</text>
      <text class="num">x{{item.quantity}}</text>
    </view>
  </view>
</view>

<!-- 总价 -->
<view class="card total-card">
  <text>实付金额</text>
  <text class="price">¥{{total}}</text>
</view>

<!-- 底部 -->
<view class="pay-bottom">
  <button class="pay-btn" bindtap="submitOrder" disabled="{{!hasAddress}}">提交订单</button>
</view>

</view>