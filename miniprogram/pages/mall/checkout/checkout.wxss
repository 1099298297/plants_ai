.container {
  background: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 120rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

/* 卡片外层 */
.address-card {
  position: relative;                /* 作为绝对定位的锚点 */
  width: 100%;
  max-width: 2000rpx;
  margin: 0 auto;
  border: 1rpx solid rgba(156, 189, 157, 0.6);
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  background: #fff;
  padding: 0;
}

/* 背景图片：撑开卡片高度，宽度100% */
.address-bg-img {
  width: 100%;
  height: auto;          /* 由 mode="widthFix" 和原图比例自动计算 */
  display: block;        /* 消除图片底部空隙 */
}

/* 文字覆盖层：绝对定位，覆盖整个卡片 */
.address-text-area {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  padding: 24rpx 100rpx 24rpx 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

/* 其他文字样式保持不变 */
.address-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1b3a1b;
}

.phone {
  font-size: 26rpx;
  color: #5e6b5e;
  font-variant-numeric: tabular-nums;
}

/* 默认标签：极细绿框 */
.default-tag {
  border: 1rpx solid #4caf50;
  background: transparent;
  color: #4caf50;
  font-size: 20rpx;
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
  line-height: 1.6;
  font-weight: 500;
}

/* 详细地址文本 */
.address-detail-text {
  font-size: 26rpx;
  color: #444;
  line-height: 1.5;
}

/* 占位文字 */
.placeholder-text {
  color: #5a705a;
  font-size: 30rpx;
}

.placeholder-sub {
  color: #7b917b;
  font-size: 24rpx;
}

.arrow {
  width: 24rpx;
  height: 24rpx;
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
}

/* 商品 */
.goods-card {
  margin-top: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.goods-item {
  display: flex;
  padding: 0;
}

.goods-item image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.goods-info {
  flex: 1;
}

.goods-info .name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.goods-info .price {
  font-size: 26rpx;
  color: #e64340;
  display: block;
}

.goods-info .num {
  font-size: 26rpx;
  color: #666;
}

/* 总价 */
.total-card {
  display: flex;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: bold;
}

.total-card .price {
  color: #e64340;
}

/* 底部按钮 */
.pay-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}

.pay-btn {
  background: #4caf50;
  color: #fff;
  border-radius: 50rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 规格样式 */
.spec {
  font-size: 24rpx;
  color: #999;
  margin: 4rpx 0;
  display: block;
}