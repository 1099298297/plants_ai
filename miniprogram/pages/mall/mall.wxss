/* mall.wxss */

/* 页面撑满全屏，禁止整体滚动 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
  overflow: hidden;
}

/* ---------- 搜索栏 ---------- */
.search-bar {
  height: 104rpx;
  background: #fff;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 0 20rpx;
  margin: 0 20rpx;
  flex: 1;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.clear-icon {
  width: 32rpx;
  height: 32rpx;
  padding: 10rpx;
}

.search-input-wrap input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
}

.search-btn {
  background: #4CAF50;
  color: #fff;
  font-size: 26rpx;
  width: 80rpx;
  height: 50rpx;
  line-height: 50rpx;
  text-align: center;
  border-radius: 25rpx;
  margin-left: 10rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 搜索建议与历史记录 */
.search-suggestions {
  background: #fff;
  border-radius: 0 0 16rpx 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  position: absolute;
  top: 104rpx;
  left: 0;
  right: 0;
  z-index: 99;
  max-height: 60vh;
  overflow-y: auto;
}

.suggestion-list {
  padding: 20rpx 0;
}

.suggestion-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
}

.suggestion-item:active {
  background: #f5f5f5;
}

.suggestion-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 20rpx;
  opacity: 0.5;
}

.search-history {
  padding: 20rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  color: #666;
}

.clear-history {
  width: 32rpx;
  height: 32rpx;
  padding: 10rpx;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.history-item {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  padding: 10rpx 20rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #666;
}

.history-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 10rpx;
  opacity: 0.5;
}

/* ---------- 主体左右分栏 ---------- */
.main-body {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* 左侧类别 */
.category-sidebar {
  width: 160rpx;
  background: #f8f8f8;
  height: 100%;
}

.category-item {
  padding: 30rpx 10rpx;
  font-size: 26rpx;
  color: #555;
  text-align: center;
  border-left: 4rpx solid transparent;
}

.category-item.active {
  background: #fff;
  color: #4CAF50;
  font-weight: bold;
  border-left-color: #4CAF50;
}

/* 右侧商品区域 */
.goods-area {
  flex: 1;
  height: 100%;
  background: #fff;
  padding: 0 16rpx;
}

/* 分类标题 */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  padding: 24rpx 8rpx 16rpx;
}

/* 商品网格（两列） */
.product-list {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.product-item {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  margin-bottom: 30rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.product-item image {
  width: 100%;
  border-radius: 10rpx;
  height: 345rpx;
}

.product-info {
  padding: 20rpx;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.price-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.product-price {
  font-size: 32rpx;
  color: #e64340;
  font-weight: bold;
}

.jump-tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 2rpx 7rpx;
  background: #fff;
  color: #e64340;
  border: 1rpx solid #e64340;
  border-radius: 6rpx;
}

/* 无结果 */
.no-result {
  width: 100%;
  padding: 100rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
}

.no-result image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.no-result text {
  font-size: 28rpx;
  color: #999;
}

.no-result-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* 加载动画 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #4CAF50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}