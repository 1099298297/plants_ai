<!-- mall.wxml -->
<view class="page">
  <!-- 顶部搜索栏（固定高度，不使用fixed） -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <image class="search-icon" src="/images/icons/search.png" mode="aspectFit"></image>
      <input type="text" 
             placeholder="搜索商品" 
             value="{{searchValue}}"
             bindinput="onSearchInput"
             bindfocus="onSearchFocus"
             bindconfirm="onSearchConfirm"
             confirm-type="search"/>
      <image wx:if="{{searchValue}}" 
             class="clear-icon" 
             src="/images/icons/clear.png" 
             mode="aspectFit"
             bindtap="clearSearch"></image>
      <view class="search-btn" bindtap="onSearchConfirm">搜索</view>
    </view>
  </view>

  <!-- 搜索建议 / 历史记录（覆盖在下方内容之上） -->
  <view class="search-suggestions" wx:if="{{showSuggestions}}">
    <view class="suggestion-list" wx:if="{{suggestions.length > 0}}">
      <view class="suggestion-item" 
            wx:for="{{suggestions}}" 
            wx:key="*this"
            bindtap="selectSuggestion"
            data-suggestion="{{item}}">
        <image class="suggestion-icon" src="/images/icons/search.png" mode="aspectFit"></image>
        <text>{{item}}</text>
      </view>
    </view>
    <view class="search-history" wx:if="{{searchHistory.length > 0 && !suggestions.length}}">
      <view class="history-header">
        <text>搜索历史</text>
        <image class="clear-history" 
               src="/images/icons/delete.png" 
               mode="aspectFit"
               bindtap="clearSearchHistory"></image>
      </view>
      <view class="history-list">
        <view class="history-item" 
              wx:for="{{searchHistory}}" 
              wx:key="*this"
              bindtap="selectSuggestion"
              data-suggestion="{{item}}">
          <image class="history-icon" src="/images/icons/history.png" mode="aspectFit"></image>
          <text>{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 主体内容：左右分栏 -->
  <view class="main-body">
    <!-- 左侧类别列表 -->
    <scroll-view class="category-sidebar" scroll-y>
      <view class="category-item {{activeCategory === item.category ? 'active' : ''}}"
            wx:for="{{categories}}"
            wx:key="category"
            bindtap="onCategoryTap"
            data-category="{{item.category}}"
            data-index="{{index}}">
        {{item.name}}
      </view>
    </scroll-view>

    <!-- 右侧商品区域 -->
    <scroll-view class="goods-area" 
                 scroll-y 
                 scroll-into-view="{{scrollToCategory}}"
                 scroll-with-animation
                 bindscroll="onGoodsScroll"
                 id="goods-scroll">
      <!-- 加载提示 -->
      <view class="loading-container" wx:if="{{isLoading}}">
        <view class="loading-spinner"></view>
        <text>加载中...</text>
      </view>

      <!-- 按类别分组展示 -->
      <block wx:for="{{groupedProducts}}" wx:key="category">
        <view class="category-section" id="cat-{{index}}">
          <view class="section-title">{{item.name}}</view>
          <view class="product-list">
            <view class="product-item" 
                  wx:for="{{item.products}}" 
                  wx:for-item="product"
                  wx:key="id" 
                  bindtap="navigateToDetail" 
                  data-id="{{product.id}}"
                  data-douyinlink="{{product.douyinLink}}">
              <image src="{{product.image[0]}}" mode="aspectFill"></image>
              <view class="product-info">
                <text class="product-name">{{product.name}}</text>
                <view class="price-row">
                  <text class="product-price">¥{{product.price}}</text>
                  <text wx:if="{{product.douyinLink}}" class="jump-tag">抖音选购</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>

      <!-- 无数据提示 -->
      <view class="no-result" wx:if="{{!isLoading && groupedProducts.length == 0}}">
        <image src="/images/icons/no-result.png" mode="aspectFit"></image>
        <text>未找到相关商品</text>
        <text class="no-result-tip">换个关键词试试吧</text>
      </view>
    </scroll-view>
  </view>

  <!-- 悬浮购物车按钮 -->
  <view class="cart-fab" bindtap="goToCart">
    <image
      class="cart-icon-img"
      src="/images/icons/cart-white.png"
      mode="aspectFit"
    ></image>

    <view wx:if="{{cartCount > 0}}" class="cart-badge">
      {{cartCount > 99 ? '99+' : cartCount}}
    </view>
  </view>
</view>